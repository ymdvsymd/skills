# LOCAL ENV — gitignored. Developer-specific paths go here.
# DO NOT COMMIT THIS FILE. .gitignore blocks `evals/*/.env.local`.
#
# Usage:
#   source evals/tech-blog-from-docs/.env.local
#   waza run tech-blog-from-docs
#
# APM_DOCS_DIR should point to a local clone of microsoft/apm's
# `docs/src/content/docs` directory. The task prompts reference
# `${APM_DOCS_DIR}/concepts/` and `${APM_DOCS_DIR}/consumer/`.

export APM_DOCS_DIR="/path/to/apm/docs/src/content/docs"
