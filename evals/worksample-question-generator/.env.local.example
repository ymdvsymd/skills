# LOCAL ENV — gitignored. Concrete paths to recruitment data go here.
# DO NOT COMMIT THIS FILE. .gitignore blocks `evals/*/.env.local`.
#
# Usage:
#   source evals/worksample-question-generator/.env.local
#   waza run worksample-question-generator
#
# Both vars accept one-or-more files. Use newline-separated bullets
# so they expand cleanly into the prompt body as a markdown bullet list.

export WAZA_TASK_FILES="  - /path/to/worksample.pdf"

export WAZA_ANSWER_FILES="  - /path/to/answer-doc.md
  - /path/to/wireframe.pdf"
