# APM cache (per APM official guidance)
apm_modules/

# Skill development workspaces and evaluation outputs (skill-creator iterations).
# Only the legacy in-skill evals/ directory is ignored; the top-level evals/
# directory (waza project-mode layout) is tracked.
skills/*/evals/
*-workspace/

# Project-scope APM artifacts (このrepoは user scope install 専用)
apm.lock.yaml
.claude/skills/

# Claude Code local settings
.claude/settings.local.json

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Defense-in-depth: local env files for eval execution that contain PII / personal paths
evals/*/.env.local
evals/*/tasks/*.local.yaml
