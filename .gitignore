# APM のキャッシュ (APM 公式ガイダンスに従い commit しない)
apm_modules/

# Skill 開発用の作業ディレクトリと eval 出力 (skill-creator の試行錯誤で生成される)。
# ここで無視するのは legacy な in-skill の evals/ のみ。
# top-level の evals/ (waza project-mode のレイアウト) は追跡対象。
skills/*/evals/
*-workspace/

# Project-scope の APM 生成物 (この repo は user-scope install 専用)
apm.lock.yaml
.claude/skills/

# Claude Code のローカル設定
.claude/settings.local.json

# waza の eval 実行で生成される成果物 (commit しない)。
# CI (.github/workflows/waza-eval.yml) は
#   waza run --output-dir results --transcript-dir transcripts --verbose
# を実行し、results/ と transcripts/ を artifact として upload する (30 日保持)。
# baseline/ と updated/ はメンテナンス workflow で regression 比較用に
# `waza run <name> --output-dir baseline|updated` が作る出力先。
# .waza-cache/ は `waza run --cache` のデフォルト cache ディレクトリ。
results/
transcripts/
baseline/
updated/
.waza-cache/

# macOS が生成するメタデータ
.DS_Store

# エディタの設定・一時ファイル
.vscode/
.idea/
*.swp
*.swo

# 多層防御: eval 実行用のローカル env ファイル (PII / 個人のパスを含むため)
evals/*/.env.local
evals/*/tasks/*.local.yaml
